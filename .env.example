# --- Database (Supabase) ---------------------------------------------
# Project → Connect → "Transaction pooler" (port 6543). Used by the app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Project → Connect → "Session pooler" (port 5432). Used by Prisma migrate.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth.js -----------------------------------------------------------
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The same Google client is used for "Connect Gmail" (job alert emails) on
# the radar page. In Google Cloud: enable the Gmail API, add the redirect URI
# <NEXT_PUBLIC_APP_URL>/api/gmail/callback, and add the gmail.readonly scope.

# --- Services ----------------------------------------------------------
GEMINI_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
PASSKEY_RP_ID=localhost

# --- Email (Gmail SMTP) -----------------------------------------------
# Needs 2-Step Verification on, then create an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# EMAIL_FROM="JobTrack <you@gmail.com>"

# --- Job link import / Job radar ---------------------------------------
# JOB_IMPORT_AI=off                 # disable the Gemini fallback for link import
# JOB_IMPORT_AI_MODEL=              # optional cheaper model for link import
# RADAR_AI_MODEL=                   # optional model for radar match explanations
# Secret for the daily radar run (/api/radar/cron). Vercel cron sends it
# automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Job radar sources ---------------------------------------------------
# JSearch / Google for Jobs (StepStone, Indeed, LinkedIn...). Either:
#   - an OpenWeb Ninja key (starts with "ak_"): https://www.openwebninja.com
#   - a RapidAPI key subscribed to JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# The provider is detected from the key; force it with JSEARCH_PROVIDER=openwebninja|rapidapi.
JSEARCH_API_KEY=
# Requests per month on your JSearch plan (free plan: 200). The radar stops
# a few short of it and falls back to Arbeitnow.
JSEARCH_MONTHLY_LIMIT=200
